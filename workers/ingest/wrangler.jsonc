{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fvtt-telemetry-ingest",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Only reachable on its own domain: no *.workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // TODO: the real domain (see the README)
  "routes": [
    {
      "pattern": "ingest.stats.lumphammer.net",
      "custom_domain": true,
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fvtt-telemetry",
      "database_id": "815bfd58-bf97-4f39-82de-12bca1628875",
    },
  ],
  "ratelimits": [
    {
      "name": "REPORT_LIMITER",
      "namespace_id": "1001",
      // per IP address: plenty for a few worlds, and keeps floods small
      "simple": {
        "limit": 10,
        "period": 60,
      },
    },
  ],
  "triggers": {
    "crons": ["17 3 * * *"],
  },
  "vars": {
    // the packages we accept reports for, comma-separated
    "PACKAGE_IDS": "investigator",
    "RAW_RETENTION_DAYS": "400",
  },
  // No request logs: they would record IP addresses.
  "observability": {
    "enabled": false,
  },
  "logpush": false,
}
