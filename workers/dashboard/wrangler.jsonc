{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "fvtt-telemetry-dashboard",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  // Only reachable on its own domain, behind Access: no *.workers.dev or
  // preview URLs, which would get around it.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dashboard.stats.lumphammer.net", "custom_domain": true },
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // the Worker checks Access before serving the app's files too
    "run_worker_first": true,
    "not_found_handling": "single-page-application",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fvtt-telemetry",
      "database_id": "815bfd58-bf97-4f39-82de-12bca1628875",
      "migrations_dir": "../../migrations",
    },
  ],
  "vars": {
    // the Zero Trust team domain, and the Access application's AUD tag
    "ACCESS_TEAM_DOMAIN": "lumphammer.cloudflareaccess.com",
    "ACCESS_AUD": "ee5e7c92d837d2bdb37cdd4e16881bb3c5f357303f87eea47b30665c2e270044",
  },
  "observability": { "enabled": false },
  "logpush": false,
}
