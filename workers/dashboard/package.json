{
  "name": "fvtt-telemetry-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "wrangler types --strict-vars=false && tsc -p . && tsc -p tsconfig.app.json",
    "test": "vitest run",
    "build": "vite build && wrangler deploy --dry-run --outdir dist-worker",
    "dev": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "seed:local": "mkdir -p .wrangler && node scripts/seedLocal.mjs > .wrangler/seed.sql && wrangler d1 migrations apply fvtt-telemetry --local && wrangler d1 execute fvtt-telemetry --local --file .wrangler/seed.sql"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@lumphammer/fvtt-telemetry-schema": "workspace:^",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  }
}
